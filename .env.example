# opensource-release-watcher environment example
#
# Copy this file to .env and update paths/settings before deployment.

# Application runtime.
SERVER_ADDR=0.0.0.0:8000
DB_PATH=./data/watcher.db
GITHUB_TOKEN=
CHECK_INTERVAL=6h
STATIC_DIR=./frontend/dist

# Optional outbound HTTP proxy for GitHub / OSV / Microsoft Graph requests.
HTTP_PROXY=http://172.20.160.1:7890
HTTPS_PROXY=http://172.20.160.1:7890
NO_PROXY=localhost,127.0.0.1

# Login. Change these before exposing the service.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
SESSION_SECRET=change-me-to-a-long-random-string

# Email notifications.
# Use graph for personal Outlook / Microsoft Graph OAuth2.
# Use smtp for company Exchange SMTP relay or other SMTP servers.
MAIL_PROVIDER=graph

# Microsoft Graph OAuth2 delegated token mode.
# Generate tokens with tools/outlook_tokens.py.
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_ACCESS_TOKEN=
GRAPH_REFRESH_TOKEN=

# SMTP / Exchange relay mode.
# Common Exchange relay: SMTP_HOST=exchange-relay.internal, SMTP_PORT=25, SMTP_STARTTLS=false.
# Microsoft 365 SMTP AUTH: SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_STARTTLS=true.
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=false

# Deployment mode.
# standalone runs only the Go server and serves frontend/dist directly.
DEPLOY_MODE=standalone
